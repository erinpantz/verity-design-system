{
  "name": "verity-design-system",
  "private": true,
  "version": "0.3.3",
  "description": "Erin Tozour's design system: React components, design tokens, and fonts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./breakpoints.module.css": "./dist/breakpoints.module.css",
    "./package.json": "./package.json"
  },
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "npm run typecheck && npm run clean && vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "build:watch": "npm run clean && (tsc -p tsconfig.lib.json --watch --preserveWatchOutput & vite build --config vite.lib.config.ts --watch)",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc -b",
    "prepare": "npm run build",
    "lint": "oxlint",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "tokens": "node build-tokens.ts",
    "icons": "node build-icons.ts"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@storybook/addon-a11y": "^10.6.4",
    "@storybook/addon-docs": "^10.6.4",
    "@storybook/react-vite": "^10.6.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.6.4",
    "storybook-addon-pseudo-states": "^10.6.4",
    "style-dictionary": "^5.7.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "lottie-web": "^5.13.0"
  }
}
