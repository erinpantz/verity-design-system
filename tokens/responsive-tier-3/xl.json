{
  "container": {
    "constrained": {
      "max-width": {
        "$type": "dimension",
        "$value": "1040px",
        "$extensions": {
          "com.figma": {
            "scopes": [
              "WIDTH_HEIGHT"
            ]
          }
        }
      },
      "horizontal-margin": {
        "$type": "dimension",
        "$value": "{spacing.40}"
      }
    },
    "full-bleed": {
      "horizontal-margin": {
        "$type": "dimension",
        "$value": "{spacing.0}",
        "$extensions": {
          "com.figma": {
            "scopes": [
              "WIDTH_HEIGHT",
              "GAP"
            ]
          }
        }
      }
    },
    "wide": {
      "horizontal-margin": {
        "$type": "dimension",
        "$value": "{spacing.48}",
        "$extensions": {
          "com.figma": {
            "scopes": [
              "WIDTH_HEIGHT",
              "GAP"
            ]
          }
        }
      },
      "max-width": {
        "$type": "dimension",
        "$value": "1920px",
        "$extensions": {
          "com.figma": {
            "scopes": [
              "WIDTH_HEIGHT"
            ]
          }
        }
      }
    }
  },
  "nav-container": {
    "thickness-expanded": {
      "$type": "dimension",
      "$value": "240px"
    },
    "thickness-collapsed": {
      "$type": "dimension",
      "$value": "72px"
    },
    "padding-x-expanded": {
      "$type": "dimension",
      "$value": "{spacing.16}",
      "$description": "Left and right padding of the expanded NavContainer.",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "GAP"
          ]
        }
      }
    },
    "padding-x-collapsed": {
      "$type": "dimension",
      "$value": "{spacing.8}",
      "$description": "Left and right padding of the collapsed, top-docked NavContainer.",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "GAP"
          ]
        }
      }
    },
    "padding-bottom": {
      "$type": "dimension",
      "$value": "{spacing.16}",
      "$description": "Bottom padding of the expanded NavContainer.",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "GAP"
          ]
        }
      }
    },
    "padding-top": {
      "$type": "dimension",
      "$value": "{spacing.md}",
      "$description": "Top padding of the left-docked NavContainer.",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "GAP"
          ]
        }
      }
    }
  },
  "grid": {
    "columns": {
      "$type": "number",
      "$value": 12
    },
    "item-min-width": {
      "sm": {
        "$type": "dimension",
        "$value": "200px",
        "$description": "Minimum width of a Grid item before the row wraps, when Item width is sm (200px).",
        "$extensions": {
          "com.figma": {
            "scopes": [
              "WIDTH_HEIGHT"
            ]
          }
        }
      },
      "md": {
        "$type": "dimension",
        "$value": "300px",
        "$description": "Minimum width of a Grid item before the row wraps, when Item width is md (300px).",
        "$extensions": {
          "com.figma": {
            "scopes": [
              "WIDTH_HEIGHT"
            ]
          }
        }
      }
    }
  },
  "nav-overlay": {
    "thickness": {
      "$type": "dimension",
      "$value": "240px"
    },
    "padding": {
      "$type": "dimension",
      "$value": "{spacing.16}",
      "$description": "Padding on all sides of NavOverlay.",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "GAP"
          ]
        }
      }
    }
  },
  "main-nav": {
    "link-gap": {
      "$type": "dimension",
      "$value": "{spacing.8}",
      "$description": "Space between the primary links in MainNav.",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "GAP"
          ]
        }
      }
    },
    "group-gap": {
      "$type": "dimension",
      "$value": "{spacing.16}",
      "$description": "Space between the menu bar and the primary links in MainNav.",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "GAP"
          ]
        }
      }
    },
    "site-title-padding": {
      "$type": "dimension",
      "$value": "{spacing.8}",
      "$description": "Left inset of the site title in MainNav.",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "GAP"
          ]
        }
      }
    },
    "logo-offset": {
      "$type": "dimension",
      "$value": "{spacing.8}",
      "$description": "Bottom padding under the MainNav logo. Lifts the logo so its lowercase letters, not its tallest letters, line up with the center of the menu icon.",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "GAP"
          ]
        }
      }
    },
    "logo-height": {
      "$type": "dimension",
      "$value": "{size.22}",
      "$description": "Height of the Erin Tozour logo in MainNav. Its width follows, so the logo keeps its proportions.",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "WIDTH_HEIGHT"
          ]
        }
      }
    }
  },
  "nav-item": {
    "padding": {
      "$type": "dimension",
      "$value": "{spacing.8}",
      "$description": "Padding on all sides of a NavItem (its tap area).",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "GAP"
          ]
        }
      }
    },
    "gap": {
      "$type": "dimension",
      "$value": "{spacing.8}",
      "$description": "Space between a NavItem icon and its label.",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "GAP"
          ]
        }
      }
    }
  },
  "tooltip": {
    "padding-x": {
      "$type": "dimension",
      "$value": "{spacing.8}",
      "$description": "Left and right padding inside a Tooltip.",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "GAP"
          ]
        }
      }
    },
    "padding-y": {
      "$type": "dimension",
      "$value": "{spacing.4}",
      "$description": "Top and bottom padding inside a Tooltip.",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "GAP"
          ]
        }
      }
    },
    "offset": {
      "$type": "dimension",
      "$value": "{spacing.8}",
      "$description": "Gap between a tooltip and the element it describes. Leaves room for the focus ring.",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "GAP"
          ]
        }
      }
    }
  },
  "unordered-list": {
    "marker-size": {
      "$type": "dimension",
      "$value": "{size.20}",
      "$description": "Width and height of the marker before each UnorderedList item.",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "WIDTH_HEIGHT"
          ]
        }
      }
    }
  },
  "gallery": {
    "item-min-width": {
      "$type": "dimension",
      "$value": "200px",
      "$description": "Minimum width of a Gallery item before the Gallery stacks into one column (200px).",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "WIDTH_HEIGHT"
          ]
        }
      }
    }
  },
  "skeleton": {
    "duration": {
      "$type": "duration",
      "$value": "{duration.1500}",
      "$description": "Time for the Skeleton pulse to go from its base color to its shine, and the same back, in milliseconds."
    }
  },
  "footer": {
    "call-to-action": {
      "min-width": {
        "$type": "dimension",
        "$value": "320px",
        "$description": "Narrowest the Footer call to action gets before the links wrap below it (320px).",
        "$extensions": {
          "com.figma": {
            "scopes": [
              "WIDTH_HEIGHT"
            ]
          }
        }
      },
      "max-width": {
        "$type": "dimension",
        "$value": "400px",
        "$description": "Widest the Footer call to action gets, so its text keeps a comfortable line length (400px).",
        "$extensions": {
          "com.figma": {
            "scopes": [
              "WIDTH_HEIGHT"
            ]
          }
        }
      }
    },
    "links": {
      "min-width": {
        "$type": "dimension",
        "$value": "480px",
        "$description": "Narrowest the Footer links area gets before it wraps below the call to action (480px). Wide enough for all the link groups on one row, with a little room for longer labels.",
        "$extensions": {
          "com.figma": {
            "scopes": [
              "WIDTH_HEIGHT"
            ]
          }
        }
      }
    }
  },
  "media-text": {
    "stack-width": {
      "$type": "dimension",
      "$value": "800px",
      "$description": "Below this width, a row MediaText stacks its text above its media (800px). Measured on MediaText itself, not the screen.",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "WIDTH_HEIGHT"
          ]
        }
      }
    }
  },
  "theme-toggle": {
    "duration": {
      "rotation": {
        "$type": "duration",
        "$value": "{duration.6000}",
        "$description": "Time for one full turn of the ThemeToggle star while hovered, in milliseconds."
      }
    },
    "glow": {
      "blur": {
        "$type": "dimension",
        "$value": "{shadow.glow.blur}",
        "$description": "Blur of the glow behind the ThemeToggle star.",
        "$extensions": {
          "com.figma": {
            "scopes": [
              "EFFECT_FLOAT"
            ]
          }
        }
      }
    }
  }
}
