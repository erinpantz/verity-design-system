{
  "button": {
    "primary": {
      "color": {
        "background": {
          "default": {
            "$type": "color",
            "$value": "{color.brand.red.600}"
          },
          "hover": {
            "$type": "color",
            "$value": "{color.brand.red.500}"
          },
          "active": {
            "$type": "color",
            "$value": "{color.brand.red.500}"
          },
          "disabled": {
            "$type": "color",
            "$value": "{color.brand.red.300}"
          }
        },
        "content": {
          "default": {
            "$type": "color",
            "$value": "{color.brand.red.100}"
          },
          "hover": {
            "$type": "color",
            "$value": "{color.neutral.white}"
          },
          "active": {
            "$type": "color",
            "$value": "{color.neutral.white}"
          },
          "disabled": {
            "$type": "color",
            "$value": "{color.brand.red.400}"
          }
        }
      },
      "brand": {
        "color": {
          "background": {
            "default": {
              "$type": "color",
              "$value": "{color.background.accent-one}"
            },
            "hover": {
              "$type": "color",
              "$value": "{color.background.accent-one-hover}"
            },
            "active": {
              "$type": "color",
              "$value": "{color.background.accent-one}"
            },
            "disabled": {
              "$type": "color",
              "$value": "{color.transparent.white-25}"
            }
          },
          "content": {
            "default": {
              "$type": "color",
              "$value": "{color.brand.red.600}"
            },
            "hover": {
              "$type": "color",
              "$value": "{color.brand.red.500}"
            },
            "active": {
              "$type": "color",
              "$value": "{color.brand.red.500}"
            },
            "disabled": {
              "$type": "color",
              "$value": "{color.brand.red.300}"
            }
          }
        }
      }
    },
    "secondary": {
      "color": {
        "content": {
          "default": {
            "$type": "color",
            "$value": "{color.brand.red.100}"
          },
          "hover": {
            "$type": "color",
            "$value": "{color.neutral.white}"
          },
          "active": {
            "$type": "color",
            "$value": "{color.neutral.white}"
          },
          "disabled": {
            "$type": "color",
            "$value": "{color.brand.red.400}"
          }
        },
        "border": {
          "default": {
            "$type": "color",
            "$value": "{color.brand.red.100}"
          },
          "hover": {
            "$type": "color",
            "$value": "{color.neutral.white}"
          },
          "active": {
            "$type": "color",
            "$value": "{color.neutral.white}"
          },
          "disabled": {
            "$type": "color",
            "$value": "{color.brand.red.400}"
          }
        }
      },
      "knockout": {
        "color": {
          "content": {
            "default": {
              "$type": "color",
              "$value": "{color.brand.red.600}"
            },
            "hover": {
              "$type": "color",
              "$value": "{color.brand.red.500}"
            },
            "active": {
              "$type": "color",
              "$value": "{color.brand.red.500}"
            },
            "disabled": {
              "$type": "color",
              "$value": "{color.brand.red.400}"
            }
          },
          "border": {
            "default": {
              "$type": "color",
              "$value": "{color.brand.red.600}"
            },
            "hover": {
              "$type": "color",
              "$value": "{color.brand.red.500}"
            },
            "active": {
              "$type": "color",
              "$value": "{color.brand.red.500}"
            },
            "disabled": {
              "$type": "color",
              "$value": "{color.brand.red.400}"
            }
          }
        }
      }
    }
  },
  "link": {
    "color": {
      "content": {
        "default": {
          "$type": "color",
          "$value": "{color.brand.red.400}"
        },
        "hover": {
          "$type": "color",
          "$value": "{color.brand.red.300}"
        },
        "active": {
          "$type": "color",
          "$value": "{color.brand.red.300}"
        },
        "visited": {
          "$type": "color",
          "$value": "{color.brand.red.400}"
        },
        "disabled": {
          "$type": "color",
          "$value": "{color.content.disabled}",
          "$description": "Link that can’t be followed yet, such as a “coming soon” page. Not underlined."
        }
      }
    },
    "brand": {
      "color": {
        "content": {
          "default": {
            "$type": "color",
            "$value": "{color.brand.red.100}"
          },
          "hover": {
            "$type": "color",
            "$value": "{color.neutral.white}"
          },
          "active": {
            "$type": "color",
            "$value": "{color.neutral.white}"
          },
          "visited": {
            "$type": "color",
            "$value": "{color.brand.red.100}"
          },
          "disabled": {
            "$type": "color",
            "$value": "{color.content.disabled}",
            "$description": "Disabled link on a brand background."
          }
        }
      }
    },
    "knockout": {
      "color": {
        "content": {
          "default": {
            "$type": "color",
            "$value": "{color.brand.red.600}"
          },
          "hover": {
            "$type": "color",
            "$value": "{color.brand.red.500}"
          },
          "active": {
            "$type": "color",
            "$value": "{color.brand.red.500}"
          },
          "visited": {
            "$type": "color",
            "$value": "{color.brand.red.600}"
          },
          "disabled": {
            "$type": "color",
            "$value": "{color.brand.neutral.600}",
            "$description": "Disabled link on a knockout (light) background."
          }
        }
      }
    }
  },
  "nav-icon": {
    "color": {
      "accent-yellow": {
        "$type": "color",
        "$value": "{color.accent.yellow}"
      },
      "accent-brand": {
        "$type": "color",
        "$value": "{color.brand.red.500}"
      },
      "default": {
        "$type": "color",
        "$value": "{color.brand.red.100}"
      },
      "accent-three": {
        "$type": "color",
        "$value": "{color.brand.blue.500}"
      },
      "accent-four": {
        "$type": "color",
        "$value": "{color.brand.orange.400}"
      }
    }
  },
  "skeleton": {
    "color": {
      "shine": {
        "$type": "color",
        "$value": "{color.brand.red.700}",
        "$description": "The lighter end of the Skeleton pulse while media loads. The other end is color/background/subtle.",
        "$extensions": {
          "com.figma": {
            "scopes": [
              "ALL_FILLS"
            ]
          }
        }
      }
    }
  },
  "theme-toggle": {
    "color": {
      "current": {
        "$type": "color",
        "$value": "{color.brand.red.500}",
        "$description": "ThemeToggle star at rest: the current theme’s brand color, step 500 so it reaches 3:1 on the dark background.",
        "$extensions": {
          "com.figma": {
            "scopes": [
              "SHAPE_FILL"
            ]
          }
        }
      },
      "next": {
        "$type": "color",
        "$value": "{color.brand.blue.500}",
        "$description": "ThemeToggle star on hover and focus: the other theme’s brand color, previewing where a click goes.",
        "$extensions": {
          "com.figma": {
            "scopes": [
              "SHAPE_FILL"
            ]
          }
        }
      }
    },
    "glow": {
      "current": {
        "$type": "color",
        "$value": "{color.brand.transparent.red-500-50}",
        "$description": "Glow behind the ThemeToggle star at rest.",
        "$extensions": {
          "com.figma": {
            "scopes": [
              "EFFECT_COLOR"
            ]
          }
        }
      },
      "next": {
        "$type": "color",
        "$value": "{color.brand.transparent.blue-500-50}",
        "$description": "Glow behind the ThemeToggle star on hover and focus.",
        "$extensions": {
          "com.figma": {
            "scopes": [
              "EFFECT_COLOR"
            ]
          }
        }
      }
    }
  },
  "nav-card": {
    "icon": {
      "color": {
        "accent-brand": {
          "$type": "color",
          "$value": "{color.brand.red.300}",
          "$description": "Replaces nav-icon/color/accent-brand on a NavCard: the nav’s brand accent would match the card’s brand fill. Brand 300 in each theme.",
          "$extensions": {
            "com.figma": {
              "scopes": [
                "ALL_FILLS",
                "STROKE_COLOR"
              ]
            }
          }
        }
      }
    }
  }
}
